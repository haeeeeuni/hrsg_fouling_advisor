# specs/18-nonfunctional.md §7 환경 변수.
# 실제 .env 는 저장소에 커밋하지 않는다(AGENTS.md §7).

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=hrsg
DB_USER=hrsg
DB_PASSWORD=hrsg
DB_HOST=localhost
DB_PORT=5432

# 업로드 원본은 미디어 루트 밖 별도 경로에 둔다(specs/18 §2).
MEDIA_ROOT=./var/media
UPLOAD_ROOT=./var/uploads
REPORT_ROOT=./var/reports
MODEL_ARTIFACT_ROOT=./var/models

# 개발용 프론트 오리진(운영은 동일 오리진이라 불필요)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Phase 2에서 비동기 실행기 확정 시 사용
# CELERY_BROKER_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# 운영 (config.settings.prod). 개발에는 필요 없다. specs/18 §7
# ---------------------------------------------------------------------------
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_DEBUG=False
#
# 반드시 새로 생성한다. 예시값이나 50자 미만이면 prod.py 가 기동을 거부한다.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# DJANGO_SECRET_KEY=
#
# 서비스 도메인을 명시한다(와일드카드 금지).
# DJANGO_ALLOWED_HOSTS=hrsg.example.co.kr
#
# TLS 를 앞단 LB 에서 끊고 리다이렉트까지 처리한다면 False 로 둔다.
# DJANGO_SECURE_SSL_REDIRECT=True
#
# Celery — compose 에서는 서비스명(redis)으로 접근한다.
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
#
# Gunicorn (기본값으로 충분하면 생략)
# GUNICORN_WORKERS=5
# GUNICORN_TIMEOUT=120
#
# Nginx 포트 매핑
# HTTP_PORT=80
# HTTPS_PORT=443
