# specs/18-nonfunctional.md §7 환경 변수.
# 실제 .env 는 저장소에 커밋하지 않는다(AGENTS.md §7).

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=hrsg
DB_USER=hrsg
DB_PASSWORD=hrsg
DB_HOST=localhost
DB_PORT=5432

# 업로드 원본은 미디어 루트 밖 별도 경로에 둔다(specs/18 §2).
MEDIA_ROOT=./var/media
UPLOAD_ROOT=./var/uploads
REPORT_ROOT=./var/reports
MODEL_ARTIFACT_ROOT=./var/models

# 개발용 프론트 오리진(운영은 동일 오리진이라 불필요)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Phase 2에서 비동기 실행기 확정 시 사용
# CELERY_BROKER_URL=redis://localhost:6379/0
