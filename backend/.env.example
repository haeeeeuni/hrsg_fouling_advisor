# 환경 변수 (specs/13 §6).
# 실제 .env 는 저장소에 커밋하지 않는다(AGENTS.md §7).

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=hrsg
DB_USER=hrsg
DB_PASSWORD=hrsg
DB_HOST=localhost
DB_PORT=5432

# 개발용 프론트 오리진(운영은 동일 오리진이라 불필요)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Celery (문서 색인). 기본값이 로컬 Redis 다.
# CELERY_BROKER_URL=redis://localhost:6379/0

# LLM API 키 암호화 키 (specs/04 LLM-2) — N5(질의응답)부터 필수. SECRET_KEY 와 다른 값을 쓴다.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# 운영 (config.settings.prod). 개발에는 필요 없다. specs/13 §6
# ---------------------------------------------------------------------------
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_DEBUG=False
#
# 반드시 새로 생성한다. 예시값이나 50자 미만이면 prod.py 가 기동을 거부한다.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# DJANGO_SECRET_KEY=
#
# 서비스 도메인을 명시한다(와일드카드 금지).
# DJANGO_ALLOWED_HOSTS=hrsg.example.co.kr
#
# TLS 를 앞단 LB 에서 끊고 리다이렉트까지 처리한다면 False 로 둔다.
# DJANGO_SECURE_SSL_REDIRECT=True
#
# Celery — compose 에서는 서비스명(redis)으로 접근한다.
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
#
# Gunicorn (기본값으로 충분하면 생략)
# GUNICORN_WORKERS=5
# GUNICORN_TIMEOUT=120
#
# Nginx 포트 매핑
# HTTP_PORT=80
# HTTPS_PORT=443
