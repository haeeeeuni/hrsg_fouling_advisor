!backend/reports/fonts/OFL.txt
*.csv

# Python
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
# pytest-cov 병렬 모드가 남기는 .coverage.<host>.<pid>.<rand>
.coverage.*
htmlcov/

# 환경 변수·비밀정보 (AGENTS.md §7)
.env
.env.*
!.env.example

# 런타임 산출물 (업로드 원본, 리포트, 모델 아티팩트)
backend/var/
backend/staticfiles/

# Node
frontend/node_modules/
frontend/dist/

# TLS 인증서·키는 저장소에 두지 않는다 (AGENTS.md §7)
deploy/certs/
